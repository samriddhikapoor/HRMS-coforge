@page
@model RegisterModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>HRMS Register</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

            * {
                font-family: 'Segoe UI';
            }

            body {
                margin: 0;
                background: #F2F3F4;
            }

            .register-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 30px;
            }

            .register-card {
                width: 1150px;
                min-height: 700px;
                border-radius: 25px;
                overflow: hidden;
                background: white;
                box-shadow: 0 20px 60px rgba(0,0,0,.15);
                display: flex;
            }

            .left-panel {
                width: 43%;
                background: linear-gradient(135deg,#363955,#54668E,#879EC6);
                color: white;
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                clip-path: polygon(0 0,100% 0,88% 100%,0 100%);
            }

                .left-panel::before {
                    content: "";
                    position: absolute;
                    width: 650px;
                    height: 650px;
                    background: rgba(255,255,255,.08);
                    border-radius: 50%;
                    left: -200px;
                    top: -100px;
                }

                .left-panel::after {
                    content: "";
                    position: absolute;
                    width: 450px;
                    height: 450px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.05);
                    right: -180px;
                    bottom: -170px;
                }

            .brand {
                position: relative;
                z-index: 5;
                width: 75%;
            }

                .brand h1 {
                    font-size: 58px;
                    font-weight: 700;
                    margin-bottom: 25px;
                }

                .brand h2 {
                    font-size: 30px;
                    font-weight: 600;
                    line-height: 1.4;
                }

                .brand p {
                    font-size: 17px;
                    margin-top: 25px;
                    opacity: .95;
                    line-height: 1.7;
                }

            .right-panel {
                width: 57%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: white;
                padding: 35px 55px;
            }

            .register-box {
                width: 100%;
                max-width: 570px;
            }

                .register-box h2 {
                    font-weight: bold;
                    color: #363955;
                    margin-bottom: 5px;
                }

                .register-box > p {
                    color: gray;
                    margin-bottom: 25px;
                }

            .form-label {
                color: #363955;
                font-weight: 600;
                margin-bottom: 7px;
            }

            .form-control,
            .form-select {
                height: 48px;
                border-radius: 10px;
                border: 1px solid #ddd;
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: #54668E;
                    box-shadow: 0 0 8px rgba(84,102,142,.25);
                }

            .btn-register {
                background: linear-gradient(90deg,#363955,#54668E);
                color: white;
                height: 50px;
                border-radius: 11px;
                border: none;
                font-size: 17px;
                font-weight: 600;
            }

                .btn-register:hover {
                    background: #59598E;
                    color: white;
                }

            .login-link {
                color: #59598E;
                text-decoration: none;
                font-weight: 600;
            }

                .login-link:hover {
                    color: #363955;
                }

            .text-danger {
                font-size: 13px;
            }

            @@media (max-width: 900px) {

                .register-card {
                    width: 100%;
                }

                .left-panel {
                    display: none;
                }

                .right-panel {
                    width: 100%;
                }
            }

    </style>

</head>

<body>

    <div class="register-container">

        <div class="register-card">

            <!-- ================= LEFT PANEL ================= -->

            <div class="left-panel">

                <div class="brand">

                    <h1>HRMS</h1>

                    <h2>
                        Human Resource
                        <br />
                        Management System
                    </h2>

                    <p>
                        Create your employee account and
                        become a part of the organization.
                    </p>

                </div>

            </div>


            <!-- ================= RIGHT PANEL ================= -->

            <div class="right-panel">

                <div class="register-box">

                    <h2>Create Account</h2>

                    <p>
                        Enter your details to register.
                    </p>


                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- ROW 1 -->

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.EmployeeName"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.EmployeeName"
                                       class="form-control"
                                       placeholder="Enter employee name" />

                                <span asp-validation-for="Input.EmployeeName"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.Email"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.Email"
                                       class="form-control"
                                       placeholder="Enter email" />

                                <span asp-validation-for="Input.Email"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ROW 2 -->

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.PhoneNumber"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.PhoneNumber"
                                       class="form-control"
                                       placeholder="Enter phone number" />

                                <span asp-validation-for="Input.PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.Designation"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.Designation"
                                       class="form-control"
                                       placeholder="e.g. Software Developer" />

                                <span asp-validation-for="Input.Designation"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ROW 3 -->

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.JoiningDate"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.JoiningDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="Input.JoiningDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.DepartmentId"
                                       class="form-label">
                                    Department
                                </label>

                                <select asp-for="Input.DepartmentId"
                                        class="form-select">

                                    <option value="">
                                        -- Select Department --
                                    </option>

                                    @foreach (var department in Model.Departments)
                                    {
                                        <option value="@department.DepartmentId">
                                            @department.DepartmentName
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="Input.DepartmentId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ROW 4 -->

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.Password"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       placeholder="Enter password" />

                                <span asp-validation-for="Input.Password"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Input.ConfirmPassword"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control"
                                       placeholder="Confirm password" />

                                <span asp-validation-for="Input.ConfirmPassword"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- REGISTER BUTTON -->

                        <button type="submit"
                                class="btn btn-register w-100 mt-2">

                            Create Account

                        </button>

                    </form>


                    <!-- LOGIN LINK -->

                    <div class="text-center mt-4">

                        Already have an account?

                        <a asp-page="./Login"
                           class="login-link">

                            Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    @section Scripts {

        <partial name="_ValidationScriptsPartial" />

    }

</body>

</html>