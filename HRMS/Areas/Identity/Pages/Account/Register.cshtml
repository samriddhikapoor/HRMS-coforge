@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background: #fff8fa !important;
    }

    .register-page {
        min-height: 100vh;
        padding: 30px 20px;

        background:
            radial-gradient(circle at 8% 10%, #f8dce5 0, transparent 27%),
            radial-gradient(circle at 92% 90%, #f5d8e1 0, transparent 30%),
            linear-gradient(135deg, #fffaf9, #fff);
    }

    .register-container {
        width: min(1180px, 100%);
        margin: auto;

        display: grid;
        grid-template-columns: 36% 64%;

        min-height: 700px;

        overflow: hidden;
        border-radius: 28px;

        background: white;

        border: 1px solid #efdee4;

        box-shadow:
            0 25px 70px rgba(104,55,72,.13);
    }

    /* LEFT */

    .register-left {
        position: relative;
        overflow: hidden;

        padding: 50px 45px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        color: white;

        background:
            radial-gradient(circle at 85% 20%, rgba(255,255,255,.15), transparent 28%),
            radial-gradient(circle at 10% 85%, rgba(255,255,255,.12), transparent 35%),
            linear-gradient(145deg, #c15b80, #994563);
    }

    .register-left::before {
        content: "";
        position: absolute;

        width: 430px;
        height: 430px;

        border-radius: 50%;

        background: rgba(255,255,255,.06);

        top: -180px;
        right: -170px;
    }

    .register-left::after {
        content: "";
        position: absolute;

        width: 300px;
        height: 300px;

        border-radius: 50%;

        background: rgba(255,255,255,.06);

        bottom: -150px;
        left: -120px;
    }

    .register-brand {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: center;
        gap: 13px;
    }

    .register-logo {
        width: 48px;
        height: 48px;

        border-radius: 15px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 25px;

        background: rgba(255,255,255,.17);
        border: 1px solid rgba(255,255,255,.25);
    }

    .register-brand-name {
        font-family: Georgia, serif;
        font-size: 25px;
        font-weight: bold;
    }

    .register-brand-sub {
        display: block;
        font-size: 8px;
        letter-spacing: 2.5px;
        opacity: .75;
    }

    .register-left-content {
        position: relative;
        z-index: 2;
    }

    .register-left-content h1 {
        font-family: Georgia, serif;
        font-size: 46px;
        line-height: 1.1;
        margin-bottom: 20px;
    }

    .register-left-content h1 span {
        color: #ffe0e9;
        font-style: italic;
    }

    .register-left-content p {
        max-width: 340px;
        font-size: 15px;
        line-height: 1.8;
        color: rgba(255,255,255,.82);
    }

    .register-note {
        position: relative;
        z-index: 2;

        padding: 18px;

        border-radius: 17px;

        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);

        font-size: 12px;
        line-height: 1.6;

        max-width: 310px;
    }

    /* RIGHT */

    .register-right {
        padding: 48px 65px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .register-form {
        width: 100%;
        max-width: 650px;
    }

    .register-heading {
        margin-bottom: 27px;
    }

    .register-heading h2 {
        font-family: Georgia, serif;
        font-size: 38px;
        color: #28243a;
        margin-bottom: 7px;
    }

    .register-heading p {
        color: #81767d;
        font-size: 14px;
        margin: 0;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 17px 25px;
    }

    .field {
        min-width: 0;
    }

    .field.full {
        grid-column: 1 / -1;
    }

    .field label {
        display: block;
        color: #393344;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .register-input,
    .register-select {
        width: 100%;
        height: 49px;

        padding: 0 14px;

        border: 1px solid #eadde2;
        border-radius: 11px;

        background: #fffafb;

        outline: none;

        color: #332d3a;
        font-size: 13px;

        transition: .25s ease;
    }

    .register-input:focus,
    .register-select:focus {
        border-color: #c45d82;
        background: white;

        box-shadow:
            0 0 0 4px rgba(196,93,130,.09);
    }

    .register-input::placeholder {
        color: #aaa0a5;
    }

    .validation {
        font-size: 11px;
        color: #b33f5f;
        margin-top: 4px;
    }

    .create-button {
        width: 100%;
        height: 52px;

        border: none;
        border-radius: 12px;

        margin-top: 24px;

        color: white;

        background:
            linear-gradient(135deg, #cb6388, #b44d72);

        font-size: 14px;
        font-weight: 700;

        box-shadow:
            0 10px 25px rgba(180,77,114,.22);

        cursor: pointer;

        transition: .25s ease;
    }

    .create-button:hover {
        transform: translateY(-2px);

        box-shadow:
            0 14px 28px rgba(180,77,114,.3);
    }

    .login-link-box {
        margin-top: 18px;

        text-align: center;

        color: #7c7177;
        font-size: 13px;
    }

    .login-link-box a {
        color: #b64e73;
        text-decoration: none;
        font-weight: 700;
    }

    .login-link-box a:hover {
        text-decoration: underline;
    }

    .validation-summary {
        color: #b33f5f;
        font-size: 12px;
        margin-bottom: 15px;
    }

    @@media(max-width: 950px) {

        .register-container {
            grid-template-columns: 1fr;
        }

        .register-left {
            min-height: 330px;
        }

        .register-right {
            padding: 45px 35px;
        }
    }

    @@media(max-width: 650px) {

        .register-page {
            padding: 15px;
        }

        .register-left {
            padding: 30px;
        }

        .register-left-content h1 {
            font-size: 37px;
        }

        .register-right {
            padding: 35px 22px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .field.full {
            grid-column: auto;
        }

        .register-heading h2 {
            font-size: 32px;
        }
    }
</style>


<div class="register-page">

    <div class="register-container">

        <!-- LEFT PANEL -->

        <div class="register-left">

            <div class="register-brand">

                <div class="register-logo">
                    ♡
                </div>

                <div>

                    <div class="register-brand-name">
                        HRMS
                    </div>

                    <span class="register-brand-sub">
                        WORKFORCE HUB
                    </span>

                </div>

            </div>


            <div class="register-left-content">

                <h1>
                    Create your<br />
                    <span>workspace.</span>
                </h1>

                <p>
                    Join your organization and become part
                    of a better, simpler and more connected
                    workplace experience.
                </p>

            </div>


            <div class="register-note">

                ♡ &nbsp;

                Your information helps us create
                your personalized employee workspace.

            </div>

        </div>


        <!-- RIGHT PANEL -->

        <div class="register-right">

            <div class="register-form">

                <div class="register-heading">

                    <h2>
                        Create Account
                    </h2>

                    <p>
                        Enter your details to register as an employee.
                    </p>

                </div>


                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>


                    <div class="form-grid">

                        <!-- EMPLOYEE NAME -->

                        <div class="field">

                            <label asp-for="Input.EmployeeName">
                                Employee Name
                            </label>

                            <input asp-for="Input.EmployeeName"
                                   class="register-input"
                                   placeholder="Enter employee name" />

                            <span asp-validation-for="Input.EmployeeName"
                                  class="validation">
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="field">

                            <label asp-for="Input.Email">
                                Email
                            </label>

                            <input asp-for="Input.Email"
                                   class="register-input"
                                   placeholder="Enter email address"
                                   autocomplete="username" />

                            <span asp-validation-for="Input.Email"
                                  class="validation">
                            </span>

                        </div>


                        <!-- PHONE -->

                        <div class="field">

                            <label asp-for="Input.PhoneNumber">
                                Phone Number
                            </label>

                            <input asp-for="Input.PhoneNumber"
                                   class="register-input"
                                   placeholder="Enter phone number" />

                            <span asp-validation-for="Input.PhoneNumber"
                                  class="validation">
                            </span>

                        </div>


                        <!-- DESIGNATION -->

                        <div class="field">

                            <label asp-for="Input.Designation">
                                Designation
                            </label>

                            <input asp-for="Input.Designation"
                                   class="register-input"
                                   placeholder="e.g. Software Developer" />

                            <span asp-validation-for="Input.Designation"
                                  class="validation">
                            </span>

                        </div>


                        <!-- JOINING DATE -->

                        <div class="field">

                            <label asp-for="Input.JoiningDate">
                                Joining Date
                            </label>

                            <input asp-for="Input.JoiningDate"
                                   type="date"
                                   class="register-input" />

                            <span asp-validation-for="Input.JoiningDate"
                                  class="validation">
                            </span>

                        </div>


                        <!-- DEPARTMENT -->

                        <div class="field">

                            <label asp-for="Input.DepartmentId">
                                Department
                            </label>

                            <!-- KEEP YOUR EXISTING asp-items HERE -->

                            <select asp-for="Input.DepartmentId"
                                    asp-items="ViewBag.Departments"
                                    class="register-select">

                                <option value="">
                                    -- Select Department --
                                </option>

                            </select>

                            <span asp-validation-for="Input.DepartmentId"
                                  class="validation">
                            </span>

                        </div>


                        <!-- PASSWORD -->

                        <div class="field">

                            <label asp-for="Input.Password">
                                Password
                            </label>

                            <input asp-for="Input.Password"
                                   class="register-input"
                                   placeholder="Create password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Input.Password"
                                  class="validation">
                            </span>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="field">

                            <label asp-for="Input.ConfirmPassword">
                                Confirm Password
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="register-input"
                                   placeholder="Confirm password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="validation">
                            </span>

                        </div>

                    </div>


                    <button type="submit"
                            class="create-button">

                        Create Account

                    </button>


                    <div class="login-link-box">

                        Already have an account?

                        <a asp-page="./Login">
                            Login
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}