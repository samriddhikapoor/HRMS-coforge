@model IEnumerable<HRMS.Models.PerformanceReview>

@{
    ViewData["Title"] = "My Performance";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">My Performance</h2>
        <p class="text-muted">
            View your performance reviews and ratings.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Review Date</th>
                                <th>Rating</th>
                                <th>Comments</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var review in Model)
                            {
                                <tr>
                                    <td>
                                        @review.ReviewDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @review.Rating / 5
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(review.Comments)
                                            ? "No comments"
                                            : review.Comments)
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5 class="text-muted">
                        No performance reviews found.
                    </h5>

                    <p class="text-muted mb-0">
                        Your performance reviews will appear here once they are added.
                    </p>
                </div>
            }

            <div class="mt-3">
                <a asp-controller="EmployeeDashboard"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back to Dashboard
                </a>
            </div>

        </div>
    </div>

</div>