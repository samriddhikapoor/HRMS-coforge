@model IEnumerable<HRMS.Models.Payroll>

@{
    ViewData["Title"] = "My Payroll";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">My Payroll</h2>
        <p class="text-muted">
            View your salary and payroll details.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Salary Month</th>
                                <th>Basic Salary</th>
                                <th>Allowance</th>
                                <th>Deduction</th>
                                <th>Net Salary</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var payroll in Model)
                            {
                                <tr>

                                    <td>
                                        @payroll.SalaryMonth.ToString("MMMM yyyy")
                                    </td>

                                    <td>
                                        ₹@payroll.BasicSalary.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@payroll.Allowance.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@payroll.Deduction.ToString("N2")
                                    </td>

                                    <td>
                                        <strong>
                                            ₹@payroll.NetSalary.ToString("N2")
                                        </strong>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No payroll records found.
                    </h5>

                    <p class="text-muted mb-0">
                        Your salary details will appear here once payroll is generated.
                    </p>

                </div>
            }

            <div class="mt-3">

                <a asp-controller="EmployeeDashboard"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back to Dashboard
                </a>

            </div>

        </div>

    </div>

</div>