@model HRMS.ViewModels.Employee.EmployeeViewModel

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">Delete Employee</h2>
        <p class="text-muted">
            Please confirm that you want to delete this employee.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this employee?
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Employee Name</label>
                    <p class="form-control-plaintext">
                        @Model.EmployeeName
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Email</label>
                    <p class="form-control-plaintext">
                        @Model.Email
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Designation</label>
                    <p class="form-control-plaintext">
                        @Model.Designation
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Department</label>
                    <p class="form-control-plaintext">
                        @Model.DepartmentId
                    </p>
                </div>

            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="EmployeeId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete Employee
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>