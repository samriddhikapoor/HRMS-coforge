@using Microsoft.AspNetCore.Identity
@using HRMS.Data

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HRMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f7f8fc;
            color: #182033;
        }

        /* ================= NAVBAR ================= */

        .hrms-navbar {
            height: 72px;
            background: #ffffff;
            border-bottom: 1px solid #e8eaf0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 5%;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #151b2d;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6754f5, #5140dc);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
            font-weight: 700;
            box-shadow: 0 5px 15px rgba(103, 84, 245, 0.25);
        }

        .brand-text {
            line-height: 1.1;
        }

        .brand-name {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .brand-subtitle {
            font-size: 10px;
            color: #8b91a3;
            letter-spacing: 2px;
            margin-top: 3px;
        }

        /* ================= NAV LINKS ================= */

        .nav-center {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link-custom {
            text-decoration: none;
            color: #687083;
            font-size: 15px;
            font-weight: 500;
            padding: 10px 16px;
            border-radius: 9px;
            transition: all 0.2s ease;
        }

        .nav-link-custom:hover {
            color: #5d4bea;
            background: #f3f1ff;
        }

        /* ================= RIGHT SIDE ================= */

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 9px;
            padding-right: 10px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #eeeafd;
            color: #5b49df;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .user-email {
            font-size: 13px;
            color: #555d70;
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ================= BUTTONS ================= */

        .login-btn {
            text-decoration: none;
            border: 1px solid #6553ed;
            color: #5c49e8;
            padding: 9px 19px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
            transition: 0.2s;
        }

        .login-btn:hover {
            background: #f2f0ff;
            color: #4d3bd2;
        }

        .register-btn {
            text-decoration: none;
            background: #5f4bed;
            color: white;
            padding: 10px 20px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
            transition: 0.2s;
            box-shadow: 0 5px 14px rgba(95, 75, 237, 0.22);
        }

        .register-btn:hover {
            background: #503dd7;
            color: white;
        }

        .logout-form {
            margin: 0;
        }

        .logout-btn {
            border: none;
            background: #fff0f1;
            color: #dc4b59;
            padding: 9px 17px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .logout-btn:hover {
            background: #ffe1e4;
            color: #c93645;
        }

        /* ================= PAGE ================= */

        .page-container {
            min-height: calc(100vh - 72px);
        }

        /* ================= FOOTER ================= */

        .hrms-footer {
            border-top: 1px solid #e8eaf0;
            background: #ffffff;
            padding: 22px 5%;
            margin-top: 50px;
            color: #8a91a2;
            font-size: 13px;
            text-align: center;
        }

        /* ================= MOBILE ================= */

        @@media (max-width: 900px) {

            .hrms-navbar {
                padding: 0 20px;
            }

            .nav-center {
                display: none;
            }

            .user-email {
                display: none;
            }
        }

        @@media (max-width: 550px) {

            .brand-subtitle {
                display: none;
            }

            .brand-name {
                font-size: 18px;
            }

            .brand-icon {
                width: 38px;
                height: 38px;
            }

            .register-btn,
            .login-btn {
                padding: 8px 12px;
            }

            .user-avatar {
                display: none;
            }
        }
    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header class="hrms-navbar">

        <!-- Logo -->
        <a asp-controller="Home"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">
                ✦
            </div>

            <div class="brand-text">
                <div class="brand-name">HRMS</div>
                <div class="brand-subtitle">WORKFORCE HUB</div>
            </div>

        </a>


        <!-- Center Navigation -->
        <nav class="nav-center">

            <a asp-controller="Home"
               asp-action="Index"
               class="nav-link-custom">
                Home
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Employee"))
                {
                    <a asp-controller="EmployeeDashboard"
                       asp-action="Index"
                       class="nav-link-custom">
                        Dashboard
                    </a>

                    <a asp-controller="EmployeeDashboard"
                       asp-action="Profile"
                       class="nav-link-custom">
                        Profile
                    </a>
                }

                @if (User.IsInRole("HR"))
                {
                    <a asp-controller="HRDashboard"
                       asp-action="Index"
                       class="nav-link-custom">
                        Dashboard
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="AdminDashboard"
                       asp-action="Index"
                       class="nav-link-custom">
                        Dashboard
                    </a>
                }

                @if (User.IsInRole("Manager"))
                {
                    <a asp-controller="ManagerDashboard"
                       asp-action="Index"
                       class="nav-link-custom">
                        Dashboard
                    </a>
                }
            }

        </nav>


        <!-- Right Side -->
        <div class="nav-right">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Logged in user -->

                <div class="user-info">

                    <div class="user-avatar">
                        @(
                            User.Identity?.Name?
                            .Substring(0, 1)
                            .ToUpper()
                            )
                    </div>

                    <span class="user-email">
                        @User.Identity?.Name
                    </span>

                </div>


                <!-- Logout -->

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post"
                      class="logout-form">

                    <button type="submit"
                            class="logout-btn">
                        Logout
                    </button>

                </form>
            }
            else
            {
                <!-- Logged out -->

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="login-btn">
                    Login
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="register-btn">
                    Register
                </a>
            }

        </div>

    </header>


    <!-- ================= PAGE CONTENT ================= -->

    <main class="page-container">
        @RenderBody()
    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="hrms-footer">
        © @DateTime.Now.Year HRMS · Workforce Management System
    </footer>


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>