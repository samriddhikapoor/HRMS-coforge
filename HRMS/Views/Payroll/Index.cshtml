@model IEnumerable<HRMS.ViewModels.Payroll.PayrollViewModel>

@{
    ViewData["Title"] = "Payroll Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Payroll Management</h2>
            <p class="text-muted mb-0">
                Manage payroll records of all employees.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Payroll
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Salary Month</th>
                                <th>Basic Salary</th>
                                <th>Allowance</th>
                                <th>Deduction</th>
                                <th>Net Salary</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payroll in Model)
                            {
                                <tr>
                                    <td>
                                        @(string.IsNullOrEmpty(payroll.EmployeeName)
                                            ? $"Employee #{payroll.EmployeeId}"
                                            : payroll.EmployeeName)
                                    </td>

                                    <td>
                                        @payroll.SalaryMonth.ToString("MMM yyyy")
                                    </td>

                                    <td>
                                        ₹@payroll.BasicSalary.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@payroll.Allowance.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@payroll.Deduction.ToString("N2")
                                    </td>

                                    <td>
                                        <strong>
                                            ₹@payroll.NetSalary.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@payroll.PayrollId"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@payroll.PayrollId"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@payroll.PayrollId"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No payroll records found.
                    </h5>

                    <p class="text-muted">
                        Click "Add Payroll" to create the first payroll record.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        + Add Payroll
                    </a>

                </div>
            }

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="HRDashboard"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

</div>