@{
    ViewData["Title"] = "Home";
}

<div class="hrms-home">

    <!-- NAVBAR -->
    <nav class="home-navbar">

        <a asp-controller="Home"
           asp-action="Index"
           class="home-brand">
            <span class="brand-icon">✦</span>

            <div>
                <strong>HRMS</strong>
                <small>WORKFORCE HUB</small>
            </div>
        </a>

        <div class="home-nav-links">

            <a asp-controller="Home"
               asp-action="Index"
               class="active">
                Home
            </a>

            <a href="#about">
                About
            </a>

            <a href="#features">
                Features
            </a>

        </div>

        <div class="home-auth">

            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="btn-login">
                Login
            </a>

            <a asp-area="Identity"
               asp-page="/Account/Register"
               class="btn-register">
                Register
            </a>

        </div>

    </nav>


    <!-- HERO -->
    <section class="hero-section">

        <div class="hero-content">

            <div class="welcome-badge">
                <span></span>
                WELCOME TO HRMS
            </div>

            <h1>
                People.
                Process.
                <span>Progress.</span>
            </h1>

            <p>
                A centralized platform to manage your workforce,
                simplify HR operations and streamline everyday
                HR operations.
            </p>

            <div class="hero-buttons">

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="primary-cta">
                    Login
                    <span>→</span>
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="secondary-cta">
                    Create Account
                </a>

            </div>

        </div>


        <!-- HERO CARD -->
        <div class="hero-card">

            <div class="hero-card-header">

                <div class="mini-logo">
                    ✦
                </div>

                <div>
                    <strong>HRMS</strong>
                    <small>Workforce Hub</small>
                </div>

            </div>

            <div class="hero-card-body">

                <div class="mini-stat">
                    <span>Employees</span>
                    <strong>Management</strong>
                </div>

                <div class="mini-stat">
                    <span>Attendance</span>
                    <strong>Tracking</strong>
                </div>

                <div class="mini-stat">
                    <span>Leave</span>
                    <strong>Requests</strong>
                </div>

                <div class="mini-stat">
                    <span>Payroll</span>
                    <strong>Processing</strong>
                </div>

            </div>

            <div class="hero-card-footer">
                <span>●</span>
                Centralized HR Operations
            </div>

        </div>

    </section>


    <!-- FEATURES -->
