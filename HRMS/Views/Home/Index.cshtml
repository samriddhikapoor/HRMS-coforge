    <!-- ABOUT -->
    <section class="about-section" id="about">

        <div class="about-card">

            <span class="section-label">
                ABOUT HRMS
            </span>

            <h2>
                A simpler way to manage your workforce.
            </h2>

            <p>
                HRMS brings employee management, attendance,
                leave management, payroll and performance
                operations together into one centralized platform.
            </p>

        </div>

