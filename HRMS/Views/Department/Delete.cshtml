@model HRMS.ViewModels.Department.DepartmentViewModel

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">Delete Department</h2>
        <p class="text-muted">
            Please confirm that you want to delete this department.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this department?
            </div>

            <div class="mb-3">
                <label class="fw-semibold">Department Name</label>
                <p class="form-control-plaintext">
                    @Model.DepartmentName
                </p>
            </div>

            <div class="mb-4">
                <label class="fw-semibold">Description</label>
                <p class="form-control-plaintext">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description available"
                        : Model.Description)
                </p>
            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="DepartmentId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete Department
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>