@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Admin Dashboard
            </h2>
        
            <p class="text-muted mb-0">
                Manage and monitor the HRMS system.
            </p>
        </div>

    </div>


    <!-- ================= SUMMARY CARDS ================= -->

    <div class="row g-4 mb-4">

        <!-- Total Employees -->
        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Total Employees
                            </p>

                            <h3 class="fw-bold mb-2">
                                @ViewBag.TotalEmployees
                            </h3>
                        </div>

                        <div class="text-primary fs-2">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="small text-decoration-none">

                        Manage Employees →

                    </a>

                </div>

            </div>

        </div>


        <!-- Departments -->
        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Departments
                            </p>

                            <h3 class="fw-bold mb-2">
                                @ViewBag.TotalDepartments
                            </h3>
                        </div>

                        <div class="text-success fs-2">
                            <i class="bi bi-building"></i>
                        </div>

                    </div>

                    <a asp-controller="Department"
                       asp-action="Index"
                       class="small text-decoration-none">

                        Manage Departments →

                    </a>

                </div>

            </div>

        </div>


        <!-- Managers -->
        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Managers
                            </p>

                            <h3 class="fw-bold mb-2">
                                @ViewBag.TotalManagers
                            </h3>
                        </div>

                        <div class="text-warning fs-2">
                            <i class="bi bi-person-badge"></i>
                        </div>

                    </div>

                    <a asp-controller="Manager"
                       asp-action="Index"
                       class="small text-decoration-none">

                        Manage Managers →

                    </a>

                </div>

            </div>

        </div>


        <!-- HR -->
        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                HR Users
                            </p>

                            <h3 class="fw-bold mb-2">
                                @ViewBag.HrCount
                            </h3>
                        </div>

                        <div class="text-info fs-2">
                            <i class="bi bi-person-workspace"></i>
                        </div>

                    </div>

                    <span class="small text-muted">
                        HR accounts in the system
                    </span>

                </div>

            </div>

        </div>


        <!-- Pending Requests -->
        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Pending Requests
                            </p>

                            <h3 class="fw-bold mb-2">
                                @ViewBag.PendingRequests
                            </h3>
                        </div>

                        <div class="text-danger fs-2">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                    </div>

                    <span class="small text-muted">
                        Leave requests awaiting action
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= MANAGEMENT ================= -->

    <div class="row g-4 mb-4">

        <!-- Management -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-1">
                        Management
                    </h5>

                    <p class="text-muted mb-4">
                        Manage employees, departments, managers and HR.
                    </p>


                    <div class="row g-3">

                        <!-- Employee Management -->
                        <div class="col-md-6">

                            <a asp-controller="Employee"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 h-100">

                                    <div class="d-flex align-items-center">

                                        <i class="bi bi-people fs-3 text-primary"></i>

                                        <div class="ms-3">

                                            <h6 class="fw-bold mb-1">
                                                Employee Management
                                            </h6>

                                            <small class="text-muted">
                                                View and manage employees
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- Department Management -->
                        <div class="col-md-6">

                            <a asp-controller="Department"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 h-100">

                                    <div class="d-flex align-items-center">

                                        <i class="bi bi-building fs-3 text-success"></i>

                                        <div class="ms-3">

                                            <h6 class="fw-bold mb-1">
                                                Department Management
                                            </h6>

                                            <small class="text-muted">
                                                Create and manage departments
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- Manager Management -->
                        <div class="col-md-6">

                            <a asp-controller="Manager"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 h-100">

                                    <div class="d-flex align-items-center">

                                        <i class="bi bi-person-badge fs-3 text-warning"></i>

                                        <div class="ms-3">

                                            <h6 class="fw-bold mb-1">
                                                Manager Management
                                            </h6>

                                            <small class="text-muted">
                                                Create, edit and manage managers
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- HR Management -->
                        <div class="col-md-6">

                            <a asp-controller="HR"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 h-100">

                                    <div class="d-flex align-items-center">

                                        <i class="bi bi-person-workspace fs-3 text-info"></i>

                                        <div class="ms-3">

                                            <h6 class="fw-bold mb-1">
                                                HR Management
                                            </h6>

                                            <small class="text-muted">
                                                Access HR operations
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= ROLE OVERVIEW ================= -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-1">
                        Role Overview
                    </h5>

                    <p class="text-muted mb-4">
                        Current users by role.
                    </p>


                    <!-- HR -->

                    <div class="d-flex justify-content-between
                        align-items-center mb-4">

                        <div>
                            <i class="bi bi-person-workspace me-2"></i>
                            HR
                        </div>

                        <span class="badge bg-info">
                            @ViewBag.HrCount
                        </span>

                    </div>


                    <!-- Managers -->

                    <div class="d-flex justify-content-between
                        align-items-center mb-4">

                        <div>
                            <i class="bi bi-person-badge me-2"></i>
                            Managers
                        </div>

                        <span class="badge bg-warning text-dark">
                            @ViewBag.ManagerCount
                        </span>

                    </div>


                    <!-- Employees -->

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>
                            <i class="bi bi-people me-2"></i>
                            Employees
                        </div>

                        <span class="badge bg-primary">
                            @ViewBag.EmployeeCount
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= QUICK ACTIONS ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-1">
                Quick Actions
            </h5>

            <p class="text-muted mb-4">
                Frequently used administrator actions.
            </p>


            <div class="row g-3">

                <!-- Create Manager -->
                <div class="col-md-4">

                    <a asp-controller="Manager"
                       asp-action="Create"
                       class="btn btn-primary w-100">

                        <i class="bi bi-person-badge me-2"></i>
                        Create Manager

                    </a>

                </div>


                <!-- Employees -->
                <div class="col-md-4">

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100">

                        <i class="bi bi-people me-2"></i>
                        Employees

                    </a>

                </div>


                <!-- Departments -->
                <div class="col-md-4">

                    <a asp-controller="Department"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100">

                        <i class="bi bi-building me-2"></i>
                        Departments

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>