@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Admin Dashboard</h2>
        <p class="text-muted mb-0">
            Manage users, employees and the overall HRMS system.
        </p>
    </div>

    <!-- SUMMARY -->
    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100">
                <p class="text-muted mb-2">Total Employees</p>
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="fw-bold mb-0">120</h2>
                    <span class="fs-1">👥</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100">
                <p class="text-muted mb-2">Departments</p>
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="fw-bold mb-0">8</h2>
                    <span class="fs-1">🏢</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100">
                <p class="text-muted mb-2">System Users</p>
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="fw-bold mb-0">15</h2>
                    <span class="fs-1">🔐</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100">
                <p class="text-muted mb-2">Pending Requests</p>
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="fw-bold mb-0">12</h2>
                    <span class="fs-1">📋</span>
                </div>
            </div>
        </div>

    </div>


    <!-- USER MANAGEMENT -->
    <div class="row g-4 mb-4">

        <div class="col-lg-8">

            <div class="card h-100">

                <div class="card-header p-4">
                    <h5 class="mb-1">User Management</h5>
                    <small class="text-muted">
                        Manage system users and their roles.
                    </small>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="fs-2">👩‍💼</div>
                                <h6 class="fw-bold mt-2">HR</h6>
                                <p class="text-muted small">
                                    Manage HR accounts.
                                </p>
                                <button class="btn btn-outline-primary btn-sm">
                                    Manage
                                </button>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="fs-2">👨‍💼</div>
                                <h6 class="fw-bold mt-2">Managers</h6>
                                <p class="text-muted small">
                                    Manage manager accounts.
                                </p>
                                <button class="btn btn-outline-primary btn-sm">
                                    Manage
                                </button>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="fs-2">👤</div>
                                <h6 class="fw-bold mt-2">Employees</h6>
                                <p class="text-muted small">
                                    Manage employee accounts.
                                </p>
                                <button class="btn btn-outline-primary btn-sm">
                                    Manage
                                </button>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- QUICK ACTIONS -->
        <div class="col-lg-4">

            <div class="card h-100">

                <div class="card-header p-4">
                    <h5 class="mb-1">Quick Actions</h5>
                    <small class="text-muted">
                        Common administrative tasks.
                    </small>
                </div>

                <div class="card-body">

                    <div class="d-grid gap-3">

                        <button class="btn btn-primary text-start">
                            ➕ Create User
                        </button>

                        <button class="btn btn-outline-primary text-start">
                            🏢 Create Department
                        </button>

                        <button class="btn btn-outline-primary text-start">
                            👥 View Employees
                        </button>

                        <button class="btn btn-outline-primary text-start">
                            🛡️ Manage Roles
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- RECENT USERS -->
    <div class="card">

        <div class="card-header p-4">
            <h5 class="mb-1">Recent Users</h5>
            <small class="text-muted">
                Recently created system accounts.
            </small>
        </div>

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Priya Sharma</td>
                        <td>priya@hrms.com</td>
                        <td>
                            <span class="badge bg-primary">
                                HR
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-success">
                                Active
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>Amit Kumar</td>
                        <td>amit@hrms.com</td>
                        <td>
                            <span class="badge bg-secondary">
                                Manager
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-success">
                                Active
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>Rahul Singh</td>
                        <td>rahul@hrms.com</td>
                        <td>
                            <span class="badge bg-success">
                                Employee
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-success">
                                Active
                            </span>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>