@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">HR Dashboard</h2>
        <p class="text-muted">
            Manage employees and HR activities from one place.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Employees</h5>
                    <p class="text-muted">
                        Manage employee records.
                    </p>

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Employees
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Departments</h5>
                    <p class="text-muted">
                        Manage company departments.
                    </p>

                    <a asp-controller="Department"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Departments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Attendance</h5>
                    <p class="text-muted">
                        View employee attendance.
                    </p>

                    <a asp-controller="Attendance"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Attendance
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Leave Requests</h5>
                    <p class="text-muted">
                        Review employee leave requests.
                    </p>

                    <a asp-controller="LeaveRequest"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Leaves
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Payroll</h5>
                    <p class="text-muted">
                        Manage employee payroll.
                    </p>
                    <a asp-controller="Payroll"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Payroll
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Performance</h5>
                    <p class="text-muted">
                        View employee performance reviews.
                    </p>

                    <a asp-controller="PerformanceReview"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Performance
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>