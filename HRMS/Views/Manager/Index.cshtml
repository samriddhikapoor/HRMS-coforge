@model IEnumerable<HRMS.Models.Manager>

@{
    ViewData["Title"] = "Manage Managers";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Manage Managers</h2>
            <p class="text-muted mb-0">
                Create and manage managers across departments.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Create Manager
        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Manager Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Manager</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Joining Date</th>
                                <th class="text-center">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var manager in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @manager.ManagerName
                                        </div>

                                        <small class="text-muted">
                                            @manager.Designation
                                        </small>
                                    </td>


                                    <td>
                                        @manager.Email
                                    </td>


                                    <td>
                                        @manager.PhoneNumber
                                    </td>


                                    <td>

                                        @if (manager.Department != null)
                                        {
                                            <span class="badge bg-light text-dark">
                                                @manager.Department.DepartmentName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not Assigned
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @manager.JoiningDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td class="text-center">

                                        <div class="btn-group"
                                             role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@manager.ManagerId"
                                               class="btn btn-sm btn-outline-info">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@manager.ManagerId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@manager.ManagerId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-person-badge fs-1 text-muted"></i>
                    </div>

                    <h5 class="fw-bold">
                        No Managers Found
                    </h5>

                    <p class="text-muted">
                        No managers have been created yet.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Create First Manager
                    </a>

                </div>
            }

        </div>

    </div>

</div>