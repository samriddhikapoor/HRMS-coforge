@model HRMS.Models.Manager

@{
    ViewData["Title"] = "Manager Details";
}

<div class="container-fluid py-4">

    ```
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Manager Details</h2>

            <p class="text-muted mb-0">
                View manager information and department assignment.
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.ManagerId"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Manager
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                Back to Managers
            </a>

        </div>

    </div>


    <!-- Manager Information -->
    <div class="row g-4">

        <!-- Profile -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-primary text-white
                            d-flex align-items-center justify-content-center"
                             style="width:70px;height:70px;font-size:28px;">

                            @Model.ManagerName.Substring(0, 1).ToUpper()

                        </div>

                        <div class="ms-3">

                            <h4 class="fw-bold mb-1">
                                @Model.ManagerName
                            </h4>

                            <span class="badge bg-primary">
                                @Model.Designation
                            </span>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- Email -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Email
                            </div>

                            <div class="fw-semibold">
                                @Model.Email
                            </div>

                        </div>


                        <!-- Phone -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Phone Number
                            </div>

                            <div class="fw-semibold">
                                @Model.PhoneNumber
                            </div>

                        </div>


                        <!-- Joining Date -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Joining Date
                            </div>

                            <div class="fw-semibold">
                                @Model.JoiningDate.ToString("dd MMMM yyyy")
                            </div>

                        </div>


                        <!-- User ID -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Account Status
                            </div>

                            <span class="badge bg-success">
                                Active
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Department -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Department Assignment
                    </h5>

                    <div class="text-center py-3">

                        <div class="mb-3">

                            <i class="bi bi-diagram-3 text-primary"
                               style="font-size:48px;">
                            </i>

                        </div>


                        @if (Model.Department != null)
                        {
                            <h4 class="fw-bold">
                                @Model.Department.DepartmentName
                            </h4>

                            @if (!string.IsNullOrWhiteSpace(
                                Model.Department.Description))
                            {
                                <p class="text-muted">
                                    @Model.Department.Description
                                </p>
                            }
                        }
                        else
                        {
                            <h5 class="text-muted">
                                No Department Assigned
                            </h5>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Actions -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Manager Actions
            </h5>

            <a asp-action="Edit"
               asp-route-id="@Model.ManagerId"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                Edit Manager

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.ManagerId"
               class="btn btn-outline-danger ms-2">

                <i class="bi bi-trash me-1"></i>
                Delete Manager

            </a>

        </div>

    </div>
    ```

</div>
