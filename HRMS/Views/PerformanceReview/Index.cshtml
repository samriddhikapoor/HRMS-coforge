@model IEnumerable<HRMS.Models.PerformanceReview>

@{
    ViewData["Title"] = "Performance Reviews";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Performance Reviews</h2>
            <p class="text-muted">
                Manage employee performance reviews.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Review
        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No performance reviews found</h5>

                    <p class="text-muted">
                        Add a performance review to get started.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Review
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Review Date</th>
                                <th>Rating</th>
                                <th>Comments</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @(item.Employee?.EmployeeName
                                            ?? $"Employee #{item.EmployeeId}")
                                    </td>

                                    <td>
                                        @item.ReviewDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        <strong>
                                            @item.Rating / 5
                                        </strong>
                                    </td>

                                    <td>
                                        @item.Comments
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.PerformanceReviewId"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.PerformanceReviewId"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.PerformanceReviewId"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>