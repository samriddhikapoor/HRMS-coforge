@model HRMS.Models.PerformanceReview

@{
    ViewData["Title"] = "Delete Performance Review";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">Delete Performance Review</h2>
        <p class="text-muted">
            Are you sure you want to delete this review?
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="alert alert-danger">
                This action cannot be undone.
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Employee
                </dt>
                <dd class="col-sm-9">
                    @(Model.Employee?.EmployeeName
                        ?? $"Employee #{Model.EmployeeId}")
                </dd>

                <dt class="col-sm-3">
                    Review Date
                </dt>
                <dd class="col-sm-9">
                    @Model.ReviewDate.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">
                    Rating
                </dt>
                <dd class="col-sm-9">
                    @Model.Rating / 5
                </dd>

                <dt class="col-sm-3">
                    Comments
                </dt>
                <dd class="col-sm-9">
                    @Model.Comments
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.PerformanceReviewId" />

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>